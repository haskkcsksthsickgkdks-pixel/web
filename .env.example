# ========================================================
# WESTWOOD SYNDICATE — DISCORD BOT CONFIGURATION
# ========================================================

# Discord Bot Token (จาก Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID (จาก Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Discord Guild / Server ID (คลิกขวาที่เซิร์ฟเวอร์ดิสคอร์ด -> Copy Server ID)
GUILD_ID=your_guild_id_here

# พอร์ตสำหรับ Web Server (ค่าเริ่มต้น: 3000)
PORT=3000

# URL เชื่อมต่อ API ของเว็บ
API_URL=http://localhost:3000
